# Carat Street Apache configuration

DirectoryIndex index.php
ServerSignature Off
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Reject unsafe diagnostic request methods.
  RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK)$ [NC]
  RewriteRule ^ - [F,L]

  # Keep local development on HTTP; use HTTPS on public hosts and proxies.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Prevent direct access to implementation and development directories.
  RewriteRule ^(?:includes|tools|video-analysis)(?:/|$) - [F,L,NC]

  # Protect repository metadata, environment files, archives and backups.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule \.(?:bak|conf|dist|env|ini|log|old|orig|sh|sql|swp|zip)$ - [F,L,NC]

  # Allow clean page URLs such as /contact while preserving existing .php URLs.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([A-Za-z0-9-]+)$ $1.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  <FilesMatch "\.(?:php|html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|gif|jpe?g|png|svg|webp|avif|ico|woff2?|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<FilesMatch "^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|README(?:\..*)?)$">
  Require all denied
</FilesMatch>
